# ==============================================================================
# DeepSeek Local Bridge Configuration Example
# Copy this file to .env and adjust as needed.
# Credentials are captured securely via `python -m deepseek.auth` into session/.
# NEVER store raw API keys or passwords in this file.
# ==============================================================================

# Server Network Binding
HOST=127.0.0.1
PORT=8000

# Rate Limiting (per-client IP requests per minute)
# Recommended: 120 for typical multi-turn agent workflows (title + main + tool turns)
RATE_LIMIT_PER_MINUTE=120

# Interactive Browser Sign-in (set to false for headless environments)
# If false, server returns 503 login_required when session expires instead of launching browser
SERVER_INTERACTIVE_LOGIN=true

# Optional: Path to persistent Chrome user profile directory
# DEEPSEEK_PROFILE_DIR=session/profile

# Optional: Extra allowed root directories for local image ingestion (colon or semicolon separated)
# Defaults automatically include: /storage/emulated/0, /data/data/com.termux/files, /sdcard, home dir, cwd
# MULTIMODAL_ALLOWED_ROOTS=/custom/storage:/mnt/media
